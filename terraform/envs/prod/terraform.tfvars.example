# AWS の画面で調べた値を書き、terraform.tfvars として保存する
hosted_zone_id = "ZXXXXXXXXXXXXX"

# 異常を知らせる宛先。apply のあとに確認のメールが届くので、本文のリンクを開いて承認する
notification_email = "you@example.com"

# GitHub の OpenID Connect の登録がアカウントにすでにあるなら false にする
create_github_oidc_provider = true

# 確かめ終わって切り替えるときに true にする。それまでは Route53 は Amplify を向いたまま
create_dns_records = false
