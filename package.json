{
  "name": "imrg-platform",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @imrg-platform/web dev",
    "build": "pnpm -r --if-present build",
    "preview": "pnpm --filter @imrg-platform/web preview",
    "check": "pnpm -r --if-present check",
    "test": "pnpm -r --if-present test",
    "lint": "eslint . && stylelint \"**/*.{css,scss,svelte}\"",
    "lint:fix": "eslint . --fix && stylelint \"**/*.{css,scss,svelte}\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "textlint": "textlint README.md \"docs/**/*.md\"",
    "verify": "pnpm audit --prod --audit-level high && pnpm run format:check && pnpm run lint && pnpm run check && pnpm run test && pnpm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,svelte}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.svelte": [
      "eslint --fix"
    ],
    "*.{json,yml,yaml,md}": [
      "prettier --write"
    ],
    "{README.md,docs/**/*.md}": [
      "textlint"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^64.5.2",
    "eslint-plugin-svelte": "^3.23.0",
    "eslint-plugin-tsdoc": "^0.5.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "postcss-html": "^2.0.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^4.1.1",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "textlint": "14.8.4",
    "textlint-rule-ja-hiragana-fukushi": "^1.3.0",
    "textlint-rule-ja-hiragana-hojodoushi": "^1.1.0",
    "textlint-rule-ja-hiragana-keishikimeishi": "^1.1.0",
    "textlint-rule-ja-no-redundant-expression": "^4.0.1",
    "textlint-rule-ja-no-weak-phrase": "^2.0.0",
    "textlint-rule-no-doubled-joshi": "^5.1.1",
    "textlint-rule-no-todo": "^2.0.1",
    "textlint-rule-preset-jtf-style": "^3.0.3",
    "textlint-rule-prh": "^6.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
