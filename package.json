{
  "name": "imrg-web-main",
  "version": "0.0.1",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint . && stylelint \"**/*.{css,scss,svelte}\"",
    "lint:fix": "eslint . --fix && stylelint \"**/*.{css,scss,svelte}\" --fix",
    "textlint": "textlint \"*.md\" \"docs/**/*.md\"",
    "format": "prettier --write .",
    "test": "vitest run",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:watch": "vitest"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,svelte}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.svelte": [
      "eslint --fix"
    ],
    "*.{json,yml,yaml,md}": [
      "prettier --write"
    ],
    "{README.md,docs/**/*.md}": [
      "textlint"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^24.13.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^64.5.2",
    "eslint-plugin-svelte": "^3.23.0",
    "eslint-plugin-tsdoc": "^0.5.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "postcss-html": "^2.0.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.7",
    "prettier-plugin-svelte": "^4.1.1",
    "sass": "^1.104.1",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "textlint": "14.0.4",
    "textlint-rule-ja-hiragana-fukushi": "^1.3.0",
    "textlint-rule-ja-hiragana-hojodoushi": "^1.1.0",
    "textlint-rule-ja-hiragana-keishikimeishi": "^1.1.0",
    "textlint-rule-ja-no-redundant-expression": "^4.0.1",
    "textlint-rule-ja-no-weak-phrase": "^2.0.0",
    "textlint-rule-no-doubled-joshi": "^5.1.0",
    "textlint-rule-no-todo": "^2.0.1",
    "textlint-rule-preset-jtf-style": "^2.3.14",
    "textlint-rule-prh": "^6.0.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-imagetools": "^12.0.1",
    "vitest": "^5.0.1"
  },
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "date-fns": "^4.4.0"
  }
}
